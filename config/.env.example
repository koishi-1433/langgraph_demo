# ============================================================
# langgraph_demo 环境配置模板（master 分支，旧版架构）
# 使用方法：复制本文件为 config/.env 并填入真实密钥
#   Windows:  copy config\.env.example config\.env
#   Linux:    cp config/.env.example config/.env
# 注意：config/.env 已被 .gitignore 排除，切勿提交真实密钥！
# 完整变量定义见 config/settings.py
#
# 提示：Settings 中的密钥字段均无默认值，缺失会直接报校验错误，
#       所以预留分组请保留变量名（值可以留空）。
# ============================================================

# ── LLM（实际生效：NVIDIA_*，OpenAI 兼容接口）──────────────
NVIDIA_API_KEY=your_nvidia_api_key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL_NAME=your_model_name

# ── 预留 LLM 配置（当前代码未使用，保留变量名即可）──────────
CHATGPT_FREE_API_KEY=
CHATGPT_FREE_BASE_URL=
CHATGPT_FREE_MODEL_NAME=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL_NAME=

# ── 高德地图 Web 服务（地理编码 / 逆地理 / 驾车 / 公交 / POI）──
AMAP_API_KEY=your_amap_api_key

# ── Tavily 搜索 ────────────────────────────────────────────
TAVILY_API_KEY=your_tavily_api_key
# 搜索返回结果条数（1~10，默认 5）
TAVILY_MAX_RESULTS=5

# ── MCP 子进程解释器（默认使用当前 sys.executable）─────────
# MCP_PYTHON_PATH=C:\path\to\python.exe

# ── 日志（默认 INFO）───────────────────────────────────────
# LOG_LEVEL=INFO
