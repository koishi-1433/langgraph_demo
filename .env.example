# ============================================================
# 旅游助手智能体（mcp-v1）环境配置模板
# 使用方法：
#   Windows:  copy .env.example .env
#   Linux:    cp .env.example .env
# 然后填入真实密钥。
# 注意：.env 已被 .gitignore 排除，切勿提交真实密钥！
# 完整定义见 MCP/config/settings.py
# ============================================================

# ── LLM（OpenAI 兼容接口，全项目唯一凭据来源）───────────────
CHATGPT_FREE_API_KEY=your_api_key_here
CHATGPT_FREE_BASE_URL=https://api.chatanywhere.tech/v1
CHATGPT_FREE_MODEL_NAME=gpt-4o-mini
LLM_TIMEOUT=60

# ── 高德地图 Web 服务（地理编码 / 路线规划 / POI）───────────
AMAP_API_KEY=your_amap_key_here

# ── Tavily 搜索 ─────────────────────────────────────────────
TAVILY_API_KEY=your_tavily_key_here
TAVILY_MAX_RESULTS=5

# ── RAG 本地知识库（设为 false 可关闭检索）──────────────────
RAG_ENABLED=true
EMBEDDING_MODEL=bge-m3
EMBEDDING_MODEL_DIR=MCP/tool_rag/mymodel
RAG_PERSIST_DIR=MCP/tool_rag/rag_db
RAG_COLLECTION_NAME=travel_knowledge
RAG_TOP_K=4
# 归一化向量的 L2 距离上限，约等于余弦相似度 >= 0.4
RAG_MAX_DISTANCE=1.10
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=80

# ── MCP 服务（默认空 = 同进程直连；填 URL 则走远程 Streamable HTTP）──
MCP_HTTP_URL=
MCP_HTTP_HOST=0.0.0.0
MCP_HTTP_PORT=9000

# ── 日志（写入 MCP/logs/app.log）────────────────────────────
LOG_LEVEL=INFO

# ── 路线规划参数（可选，由 MCP/tool_amap/config.py 读取）────
# ROUTE_PLANNING_TRAIN_DISTANCE_THRESHOLD=300
# ROUTE_PLANNING_DRIVING_COST_PER_KM=0.8
# ROUTE_PLANNING_TRAIN_COST_BASE_RATE=0.4
# ROUTE_PLANNING_API_TIMEOUT=15
